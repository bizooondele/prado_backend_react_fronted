# Nie przekierowuj fizycznie istniejących plików i katalogów (css, js, obrazy)
RewriteEngine On
RewriteEngine On
RewriteBase /~rafal/prado_backend_react_fronted/backend/

RewriteRule ^api/process-message/?$ index.php?json=processMessage [L,QSA]
RewriteRule ^api/.*$ index.php?json=api [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Przekieruj wszystkie pozostałe żądania do index.php
RewriteRule ^(.*)$ index.php/$1 [L,QSA]
